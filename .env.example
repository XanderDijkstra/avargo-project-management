# Supabase — find these under Settings → API in the Supabase dashboard.
# SERVICE_ROLE is server-only and bypasses RLS. Never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Optional: shared secret Vercel Cron will send as Bearer to /api/keepalive.
# If set, only Vercel Cron requests pass. If unset, the endpoint is open
# (only does a read, so this is fine).
CRON_SECRET=
